            "body": {
              "mode": "raw",
              "raw": "{\n  \"jsonrpc\": \"2.0\",\n  \"method\": \"get_ue_profile\",\n  \"params\": {\n    \"agent_id\": \"UE-Agent-001\"\n  },\n  \"id\": 4\n}"
            },
            "url": {
              "raw": "{{baseUrl}}:8000/task",
              "host": [
                "{{baseUrl}}"
              ],
              "port": "8000",
              "path": [
                "task"
              ]
            },
            "description": "Orchestrates A2A query to fetch UE Agent profile card from UDM."
          },
          "response": []
        },
        {
          "name": "Get Active Sessions",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "X-Agent-Id",
                "value": "supervisor_agent",
                "type": "text"
