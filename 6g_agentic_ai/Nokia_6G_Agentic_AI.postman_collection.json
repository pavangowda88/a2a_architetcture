{
  "info": {
    "name": "Nokia 6G Agentic AI",
    "description": "Postman & Thunder Client Collection for testing the 6G Agentic AI multi-agent core network microservices with pure A2A communication, UE Agent Profile, UDR AF Profile, and automated Low-Trust Re-authentication flow.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Authentication",
      "item": [
        {
          "name": "Agent Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "if (jsonData.access_token) {",
                  "    pm.collectionVariables.set(\"jwtToken\", jsonData.access_token);",
                  "    console.log(\"Access token saved to collection variable 'jwtToken'\");",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"agent_id\": \"supervisor_agent\",\n  \"agent_secret\": \"secret123\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}:9000/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "port": "9000",
              "path": [
                "auth",
                "login"
              ]
            },
            "description": "Log in an agent to receive a Bearer JWT token. The token is automatically saved into the collection variable 'jwtToken'."
          },
          "response": []
        },
        {
          "name": "Verify Token",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"token\": \"{{jwtToken}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}:9000/auth/verify",
              "host": [
                "{{baseUrl}}"
              ],
              "port": "9000",
              "path": [
                "auth",
                "verify"
              ]
            },
            "description": "Verifies an existing JWT token."
          },
          "response": []
        }
      ]
    },
    {
      "name": "Supervisor Agent (Orchestrator)",
      "item": [
        {
          "name": "Authenticate Subscriber (RPC)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "if (jsonData.result && jsonData.result.result && jsonData.result.result.session_token) {",
                  "    pm.collectionVariables.set(\"sessionToken\", jsonData.result.result.session_token);",
                  "    console.log(\"Session token saved to collection variable 'sessionToken'\");",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "X-Agent-Id",
                "value": "supervisor_agent",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"jsonrpc\": \"2.0\",\n  \"method\": \"authenticate_subscriber\",\n  \"params\": {\n    \"imsi\": \"001010123456789\",\n    \"imei\": \"imei-123456789\"\n  },\n  \"id\": 1\n}"
            },
            "url": {
              "raw": "{{baseUrl}}:8000/task",
              "host": [
                "{{baseUrl}}"
              ],
              "port": "8000",
              "path": [
                "task"
              ]
            },
            "description": "Triggers the full authentication, Agent-AKA vector generation, trust assessment, and session registration workflow via A2A."
          },
          "response": []
        },
        {
          "name": "Authenticate Subscriber - Low Trust Recovery (RPC)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "X-Agent-Id",
                "value": "supervisor_agent",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"jsonrpc\": \"2.0\",\n  \"method\": \"authenticate_subscriber\",\n  \"params\": {\n    \"imsi\": \"001010123456789\",\n    \"imei\": \"imei-123456789\",\n    \"simulate_low_trust\": true\n  },\n  \"id\": 2\n}"
            },
            "url": {
              "raw": "{{baseUrl}}:8000/task",
              "host": [
                "{{baseUrl}}"
              ],
              "port": "8000",
              "path": [
                "task"
              ]
            },
            "description": "Simulates low initial trust score, triggering automated A2A re-authentication with UDM and Security Agent to elevate trust score back to 91 (LOW risk)."
          },
          "response": []
        },
        {
          "name": "Service Request (RPC)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "X-Agent-Id",
                "value": "supervisor_agent",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"jsonrpc\": \"2.0\",\n  \"method\": \"service_request\",\n  \"params\": {\n    \"imsi\": \"001010123456789\",\n    \"session_token\": \"{{sessionToken}}\",\n    \"service_type\": \"6G_ROBOTICS_SLICE\"\n  },\n  \"id\": 3\n}"
            },
            "url": {
              "raw": "{{baseUrl}}:8000/task",
              "host": [
                "{{baseUrl}}"
              ],
              "port": "8000",
              "path": [
                "task"
              ]
            },
            "description": "Sends a QoS service request utilizing the active session token."
          },
          "response": []
        },
        {
          "name": "Get UE Profile via Orchestrator (RPC)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "X-Agent-Id",
                "value": "supervisor_agent",
